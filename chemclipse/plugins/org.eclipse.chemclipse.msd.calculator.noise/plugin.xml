<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
   <extension
         point="org.eclipse.chemclipse.chromatogram.msd.filter.massSpectrumFilterSupplier">
      <MassSpectrumFilterSupplier
      		config="org.eclipse.chemclipse.msd.calculator.noise.mad.MedianAbsoluteDeviationFilterSettings"
            description="Median Absolute Deviation (MAD) noise estimation"
            id="org.eclipse.chemclipse.msd.calculator.noise.mad"
            filter="org.eclipse.chemclipse.msd.calculator.noise.mad.MedianAbsoluteDeviationFilter"
            filterName="Median">
      </MassSpectrumFilterSupplier>
      <MassSpectrumFilterSupplier
      		config="org.eclipse.chemclipse.msd.calculator.noise.loess.LoessInterpolatorFilterSettings"
            description="LOESS noise estimation"
            id="org.eclipse.chemclipse.msd.calculator.noise.loess"
            filter="org.eclipse.chemclipse.msd.calculator.noise.loess.LoessInterpolatorFilter"
            filterName="LOESS">
      </MassSpectrumFilterSupplier>
   </extension>
</plugin>